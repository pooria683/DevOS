{
  "name": "devos",
  "productName": "DevOS",
  "version": "1.0.0",
  "description": "DevOS — a command-driven, terminal-first developer desktop shell for Windows. Not an emulator: a custom UI layer built with Electron.",
  "author": "DevOS Project",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devos-dev",
    "preview": "node scripts/preview-server.js",
    "build:icon": "node scripts/build-ico.js",
    "test": "node scripts/smoke-test.js && node scripts/dom-test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.devos.shell",
    "productName": "DevOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/devos.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DevOS"
    }
  }
}
